NODE_ENV=development

# Shared infra
DATABASE_URL=postgresql://meetai:meetai_pass@0.0.0.0:5432/meetai_dev
REDIS_URL=redis://0.0.0.0:6379/0
FRONTEND_ORIGIN=http://0.0.0.0:5173

# Auth service
AUTH_PORT=4020
JWT_SECRET=replace-with-random-string
JWT_ACTIVE_SECRET=replace-with-random-string
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=864000
SESSION_SECRET=replace-with-random-string
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://0.0.0.0:4010/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_ID_HMAC_SECRET=replace-with-strong-random-string
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Gateway
GATEWAY_PORT=4010
AUTH_SERVICE_URL=http://0.0.0.0:4020
MEETING_SERVICE_URL=http://0.0.0.0:4001

# Meeting service
PORT=4001
