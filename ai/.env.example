# ============================================================================
# ai/.env.example
# ----------------------------------------------------------------------------
# Copy to `ai/.env` and fill in any secrets. Both files live at the ai/
# package root (hoisted from ai-engine/src/ in M3).
#
# Compose mounts `ai/.env` for qa-service via `env_file:` and other ai
# services inherit selected vars from the top-level `docker-compose.yml`
# environment blocks.
#
# Sectioning mirrors core/config.py settings groups.
# ============================================================================

# ---- Redis (event broker) --------------------------------------------------
REDIS_URL=redis://0.0.0.0:6379/0
REDIS_STREAM_MAXLEN=5000

# ---- Whisper (ASR) ---------------------------------------------------------
# tiny: fastest, lower quality, fine for dev / CPU
# small: better quality, expects GPU for realtime
WHISPER_MODEL_SIZE=tiny
WHISPER_LANGUAGE=en
WHISPER_COMPUTE_TYPE=auto
WHISPER_DEVICE=auto
BUFFER_TRIMMING=segment
BUFFER_TRIMMING_SEC=15
CONFIDENCE_VALIDATION=false

# ---- Speaker diarization (Sortformer) --------------------------------------
DIARIZATION_ENABLED=true
DIARIZATION_MODEL_NAME=nvidia/diar_streaming_sortformer_4spk-v2

# ---- VAD (Silero ONNX) -----------------------------------------------------
VAD_ENABLED=true
VAD_THRESHOLD=0.5
VAD_FORCE_CPU=true

# ---- Transcription chunking ------------------------------------------------
MAX_CHUNK_TOKENS=200
MIN_CHUNK_TOKENS=60
CHUNKING_WINDOW_SECONDS=40.0
CHUNKER_ENCODER=cl100k_base

# ---- ai-worker striping ----------------------------------------------------
# Scale by setting NUM_WORKERS>1 and starting that many ai-worker replicas
# (each with its own WORKER_ID in [0..NUM_WORKERS-1]). The audio broker
# distributes events across worker ids.
NUM_WORKERS=1
WORKER_ID=0

# ---- Database --------------------------------------------------------------
# Compose interpolates ${POSTGRES_PASSWORD} into this URL — see root .env.
DATABASE_URL=postgresql://meetai:meetai_pass@0.0.0.0:5433/meetai_dev

# ---- Topic extraction (Gemini) ---------------------------------------------
TOPIC_EXTRACTION_ENABLED=true
TOPIC_WINDOW_SECONDS=80.0
TOPIC_SIMILARITY_THRESHOLD=0.85
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

DEFAULT_TOPIC_LIMIT=3
DEFAULT_CHUNK_LIMIT=15
DEFAULT_CHUNK_WEIGHT=0.7
DEFAULT_TOPIC_WEIGHT=0.3

# ---- ai-gateway (FastAPI ASR WebSocket entry) ------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
MAX_SESSIONS=100

# ---- Embedder service ------------------------------------------------------
# embedder runs as a singleton (no NUM_WORKERS striping). Other services
# call it via EMBED_SERVICE_URL. The embedder process itself strips this
# var so it never recurses through HTTP.
EMBED_SERVICE_URL=http://0.0.0.0:8200
EMBEDDER_PORT=8200

# ---- QA service ------------------------------------------------------------
QA_PORT=8100

# ---- Embedding model -------------------------------------------------------
# Switching repos requires matching EMBED_DIM and a column resize migration.
EMBED_MODEL_REPO=BAAI/bge-small-en-v1.5
EMBED_DIM=384
