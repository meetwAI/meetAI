# ============================================================================
# Root .env.example — compose-level overrides
# ----------------------------------------------------------------------------
# Copy to `.env` at the repo root (or pass via --env-file) to override the
# defaults baked into infra/docker/docker-compose.yml. These are the variables
# the COMPOSE FILE interpolates (${VAR:-default}); they are distinct from the
# per-service runtime config in server/.env and ai/.env.
#
#   docker compose --env-file .env -f infra/docker/docker-compose.yml up --build
#
# Every var below has a working dev default in compose, so an empty .env still
# brings the stack up. Set real values for any non-dev deployment.
# ============================================================================

# ---- Postgres --------------------------------------------------------------
# Interpolated into POSTGRES_PASSWORD and every service's DATABASE_URL. The dev
# default is `meetai_pass`; the pgdata volume is initialised with whatever this
# is on FIRST run, so changing it later requires recreating the volume.
POSTGRES_PASSWORD=meetai_pass

# ---- Redis -----------------------------------------------------------------
# Shared broker/cache URL. Default points at the in-compose redis service.
REDIS_URL=redis://redis:6379/0

# ---- Frontend origin (CORS) ------------------------------------------------
# meetings + gateway gate CORS to this origin (no longer '*'). Must match the
# URL the browser actually loads the web client from.
FRONTEND_ORIGIN=https://0.0.0.0:5173

# ---- Auth transport --------------------------------------------------------
# auth-service serves HTTPS (self-signed dev cert) when true; gateway calls it
# at https://auth-service:4020 accordingly.
AUTH_USE_HTTPS=true

# ---- Gateway upstream TLS ---------------------------------------------------
# When true the gateway skips certificate verification on its upstream calls
# (needed in dev because auth-service uses a self-signed cert). MUST be false
# in production so real upstream certs are verified.
GATEWAY_ALLOW_SELF_SIGNED=true

# ---- Web client API base ----------------------------------------------------
# Vite build-time var: the base URL the SPA calls (the gateway).
VITE_AUTH_URL=http://0.0.0.0:4010

# ============================================================================
# NOT set here — these live in server/.env (gitignored) because they are real
# secrets, not compose overrides:
#   JWT_SECRET / JWT_ACTIVE_SECRET, SESSION_SECRET,
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_CALLBACK_URL,
#   GOOGLE_ID_HMAC_SECRET, GOOGLE_TOKEN_ENCRYPTION_KEY,
#   AUTH_PORT / GATEWAY_PORT / PORT, *_TTL_SECONDS, AUTH_SERVICE_URL, etc.
# And ai-specific config (GEMINI_API_KEY, model settings) lives in ai/.env.
# ============================================================================
