# Development image for the web client (Vite dev server with hot reload).
# Compose bind-mounts the source over /app and keeps /app/node_modules from the
# image, so this install just needs to populate node_modules once.
FROM node:22-alpine
RUN corepack enable

WORKDIR /app

# Install dependencies. This project uses pnpm (pnpm-lock.yaml); the runtime
# `pnpm run dev` also runs `pnpm install` against the bind-mounted source, so
# esbuild's build script must be pre-approved (pnpm-workspace.yaml allowBuilds)
# or pnpm aborts non-interactively with ERR_PNPM_IGNORED_BUILDS.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile || pnpm install

# Copy the rest of the app
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Default command
CMD ["pnpm", "run", "dev"]