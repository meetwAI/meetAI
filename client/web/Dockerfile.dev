# Development image for the web client (Vite dev server with hot reload).
# Compose bind-mounts the source over /app and keeps /app/node_modules from the
# image, so this install just needs to populate node_modules once.
FROM node:20-alpine
RUN corepack enable

WORKDIR /app

# This project uses pnpm (pnpm-lock.yaml). Manifest-first for layer caching.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 5173

CMD ["pnpm", "run", "dev"]
